# Used only by domain_assistant.py when generating real RAG answers.
# Choose one provider and replace that provider's placeholder key.
LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini uses Google's OpenAI-compatible Chat Completions endpoint.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_INTERVAL_SECONDS=13
